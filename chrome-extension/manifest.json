{
  "manifest_version": 3,
  "name": "微信读书 · 悦读助手",
  "version": "1.1.0",
  "description": "宽屏显示｜自定义背景色｜沉浸式阅读｜自动阅读｜配置持久化",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://weread.qq.com/web/reader/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://weread.qq.com/"],
      "js": ["douban.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.douban.com/*",
    "https://res.weread.qq.com/*",
    "https://*.weread.qq.com/*",
    "https://*.tencent-cloud.com/*",
    "https://*.myqcloud.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js"],
      "matches": ["https://weread.qq.com/*"]
    }
  ]
}
